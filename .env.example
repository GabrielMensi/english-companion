# Optional. API keys can be set from the app's settings page,
# which takes precedence. These variables are only used as a fallback:
# copy this file to .env.local and restart the server.

# Google Gemini (free tier, no credit card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (free tier with daily limits): https://console.groq.com/keys
GROQ_API_KEY=

# SQLite database file (default: data/companion.db)
# DATABASE_PATH=data/companion.db

# Speech-to-text eval recordings (default: data/asr-samples)
# ASR_SAMPLES_DIR=data/asr-samples

# Hostnames the app answers to besides localhost, 127.0.0.1 and [::1], comma-separated,
# without scheme or port (for a deploy). Requests for any other Host get a 403.
# ALLOWED_HOSTS=companion.example.com

# Behind a reverse proxy only: use the last X-Forwarded-Host value instead of Host for the host and
# cross-site checks. "true"/"false"/"1"/"0" (default: false).
# TRUST_PROXY=false

# Login. It is always required, also locally: the first account is created at /signup.
# Emails that can create an account, comma-separated. Empty: only the first account can be created.
# Do NOT add other accounts until multi-user data scoping is merged: today every account sees all data and keys.
# With no email verification, whoever signs up first with a listed email owns it.
# SIGNUP_ALLOWED_EMAILS=ana@example.com,bruno@example.com

# Key that signs the session cookies (32+ characters, `openssl rand -base64 32`). Locally it is
# generated once in data/auth.secret; with ALLOWED_HOSTS set (a deploy) it is required, with the public URL.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://companion.example.com

# The speech-to-text eval writes recordings to disk: on in development, off in production unless "true".
# Only the first account can use it.
# ENABLE_EVAL=false

# Send the Content-Security-Policy as report-only: the browser logs violations in the console instead
# of blocking. A way back if the policy breaks something. "true"/"false"/"1"/"0" (default: false).
# CSP_REPORT_ONLY=false

# Empty values count as unset. An invalid value (e.g. TRUST_PROXY=maybe) stops the
# server at startup with a message naming the variable.
