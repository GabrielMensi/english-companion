# Optional. API keys can be set from the app's settings page,
# which takes precedence. These variables are only used as a fallback:
# copy this file to .env.local and restart the server.

# Google Gemini (free tier, no credit card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (free tier with daily limits): https://console.groq.com/keys
GROQ_API_KEY=

# SQLite database file (default: data/companion.db)
# DATABASE_PATH=data/companion.db

# Speech-to-text eval recordings (default: data/asr-samples)
# ASR_SAMPLES_DIR=data/asr-samples

# Read aloud sound check (beta): a phoneme model (~320 MB) is downloaded the first time you read
# something aloud. It uses about 0.5 GB of RAM while loaded (up to ~0.75 GB for a 30 s reading) in
# the app process: set PHONEME_CHECK=false on a small server. The model goes to PHONEME_MODEL_DIR
# (use a persistent volume in Docker).
# PHONEME_CHECK=true
# PHONEME_MODEL_DIR=data/models

# Hostnames the app answers to besides localhost, 127.0.0.1 and [::1], comma-separated,
# without scheme or port (for a deploy). Requests for any other Host get a 403.
# ALLOWED_HOSTS=companion.example.com

# Behind a reverse proxy only: use the last X-Forwarded-Host value instead of Host for the host and
# cross-site checks. "true"/"false"/"1"/"0" (default: false).
# TRUST_PROXY=false

# Empty values count as unset. An invalid value (e.g. TRUST_PROXY=maybe) stops the
# server at startup with a message naming the variable.
