{
  "name": "english-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3737 --hostname 127.0.0.1 --experimental-https",
    "build": "next build",
    "start": "next start --port 3737 --hostname 127.0.0.1",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "auth:claim-data": "tsx --tsconfig tsconfig.json scripts/auth-claim-data.mts",
    "keys:reencrypt": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/keys-reencrypt.mts",
    "auth:reset-password": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/auth-reset-password.mts",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/db-migrate.mts",
    "db:backup": "tsx --tsconfig tsconfig.json scripts/backup.mts",
    "eval:models": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval/run.mts",
    "eval:export-discards": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval/export-discards.mts",
    "eval:classify": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval/classify.mts",
    "eval:asr": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval/asr.mts",
    "eval:level": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval/level.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/groq": "^4.0.59",
    "@huggingface/transformers": "3.8.1",
    "ai": "^7.0.137",
    "better-auth": "1.7.14",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmu-pronouncing-dictionary": "3.0.0",
    "cn": "^0.4.0",
    "compromise": "^14.18.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
